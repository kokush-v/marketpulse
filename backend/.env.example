APP_NAME=MarketPulse API

DATABASE_URL=postgresql+asyncpg://marketpulse:marketpulse@localhost:5432/marketpulse_dev
TEST_DATABASE_URL=postgresql+asyncpg://marketpulse:marketpulse@localhost:5433/marketpulse_test

SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SECRET_KEY=replace-me
SUPABASE_JWT_ALGORITHM=RS256
SUPABASE_JWT_AUDIENCE=authenticated

FRONTEND_URL=http://localhost:3000

MARKET_DATA_API_BASE_URL=http://localhost:3001

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_TOKENS=1024
# Optional: Groq model for the AI assistant eval suite (make test-ai-eval); defaults to GROQ_MODEL.
ASSISTANT_EVAL_GROQ_MODEL=
ASSISTANT_MAX_TOOL_CALLS=4
# Context the assistant model sees besides the conversation summary; exceeding either limit triggers compaction.
ASSISTANT_MAX_CONTEXT_MESSAGES=30
ASSISTANT_MAX_CONTEXT_CHARACTERS=40000
# Market data older than this is marked stale in assistant answers and their sources.
ASSISTANT_MARKET_DATA_MAX_AGE_SECONDS=900

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=marketpulse-dev

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=marketpulse_bot
TELEGRAM_LINK_TOKEN_TTL_SECONDS=900
TELEGRAM_TEST_NOTIFICATION_COOLDOWN_SECONDS=10
TELEGRAM_WEBHOOK_SECRET=

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
